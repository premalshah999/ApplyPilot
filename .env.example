# No provider key is required for the local browser demo.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
# MiMo thinks by default; answers are short JSON, so thinking only adds latency. disabled|enabled|empty
MIMO_THINKING=disabled
# USD per million tokens. Adjust these to your actual provider billing.
MIMO_INPUT_PRICE=0.435
MIMO_OUTPUT_PRICE=0.87

TELEGRAM_BOT_TOKEN=
# Numeric user ID, not @username. Only this sender can control the bot.
TELEGRAM_USER_ID=
# A worker holds its browser this long waiting for your Telegram answer to an unknown question.
TELEGRAM_WAIT_SECONDS=120
CAPSOLVER_API_KEY=
# Optional image-coordinate fallback for hCaptcha puzzles. Never sent to CapSolver.
TWOCAPTCHA_API_KEY=
CAPTCHA_TIMEOUT=90
CAPTCHA_MAX_ATTEMPTS=2
# Paid image rounds per run; one hCaptcha challenge often needs 2-3 rounds.
CAPTCHA_MAX_ROUNDS=4

# Employer accounts use ONE email + password everywhere. The password is generated once and
# stored encrypted unless you set APPLICATION_PASSWORD (ACCOUNT_PASSWORD is the same setting).
# Set it before the first shared account is created; existing employer credentials are preserved.
# Account creation itself follows "Allow account creation" in the dashboard profile.
APPLICATION_PASSWORD=
# Optional login email; defaults to the profile email.
ACCOUNT_EMAIL=
# Reset a rejected employer password through its reset email (bounded, with cooldown).
ACCOUNT_PASSWORD_RESET=true

WORKERS=3
# Single-page forms (Greenhouse, Lever, Ashby).
APPLICATION_TIMEOUT=180
# Multi-page wizards with accounts and email verification (Workday, Oracle, iCIMS, Taleo).
MULTIPAGE_TIMEOUT=480
# adapters = deterministic ATS drivers (model only for answers); agent = previous navigation model.
ENGINE=adapters
# Skip images/fonts/media on employer pages (captcha providers are never blocked).
BLOCK_ASSETS=true
# DOM snapshot + screenshot + decision per step under DATA_DIR/runs/<id>/steps (see: jobpilot trace ID).
TRACE_STEPS=true
DAILY_APPLICATION_LIMIT=100
DAILY_BUDGET_USD=5
MAX_MODEL_CALLS=18
TIMEZONE=America/New_York

BASE_URL=http://127.0.0.1:8080
# Set true only with an HTTPS reverse proxy and an https BASE_URL.
SECURE_COOKIES=false
# Leave empty to generate a private token. Retrieve it with: jobpilot token
APP_TOKEN=
DATA_DIR=.data
HEADLESS=true
# Optional desktop Chrome for Docker on Mac. Run `python -m jobpilot.cli browser` on the Mac first.
# BROWSER_CDP_URL=http://host.docker.internal:9224
BROWSER_CDP_URL=
ENABLE_WORKERS=true
ENABLE_DEMO=true

# Native install: blank URLs use SQLite (development only).
# Docker Compose sets these to PostgreSQL automatically.
DATABASE_URL=
DBOS_DATABASE_URL=
# Optional custom Chromium executable for native installs.
CHROMIUM_PATH=

# App-owned Gmail connection. Configure a Google OAuth Web application and enable Gmail API.
# Exact redirect: BASE_URL + /oauth/gmail/callback (also shown in Settings).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alternative: a Google app password (requires 2-Step Verification).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional Fernet key. If blank, a private DATA_DIR/mail-key is created and must be backed up.
MAIL_ENCRYPTION_KEY=
# Poll only when an email challenge is pending; wait counts toward APPLICATION_TIMEOUT.
MAIL_POLL_SECONDS=3
MAIL_WAIT_SECONDS=90
