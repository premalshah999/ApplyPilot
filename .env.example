# No provider key is required for the local browser demo.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
# USD per million tokens. Adjust these to your actual provider billing.
MIMO_INPUT_PRICE=0.435
MIMO_OUTPUT_PRICE=0.87

TELEGRAM_BOT_TOKEN=
# Numeric user ID, not @username. Only this sender can control the bot.
TELEGRAM_USER_ID=
CAPSOLVER_API_KEY=

WORKERS=3
APPLICATION_TIMEOUT=180
DAILY_APPLICATION_LIMIT=100
DAILY_BUDGET_USD=5
MAX_MODEL_CALLS=18
TIMEZONE=America/New_York

BASE_URL=http://127.0.0.1:8080
# Set true only with an HTTPS reverse proxy and an https BASE_URL.
SECURE_COOKIES=false
# Leave empty to generate a private token. Retrieve it with: jobpilot token
APP_TOKEN=
DATA_DIR=.data
HEADLESS=true
ENABLE_WORKERS=true
ENABLE_DEMO=true

# Native install: blank URLs use SQLite (development only).
# Docker Compose sets these to PostgreSQL automatically.
DATABASE_URL=
DBOS_DATABASE_URL=
# Optional custom Chromium executable for native installs.
CHROMIUM_PATH=

# App-owned Gmail connection. Configure a Google OAuth Web application and enable Gmail API.
# Exact redirect: BASE_URL + /oauth/gmail/callback (also shown in Settings).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Fernet key. If blank, a private DATA_DIR/mail-key is created and must be backed up.
MAIL_ENCRYPTION_KEY=
# Poll only when an email challenge is pending; wait counts toward APPLICATION_TIMEOUT.
MAIL_POLL_SECONDS=3
MAIL_WAIT_SECONDS=60
